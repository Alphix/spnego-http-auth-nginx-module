ngx_addon_name=ngx_http_auth_spnego_module

spnego_libs=$(pkg-config --libs krb5-gssapi)
spnego_cflags=$(pkg-config --cflags krb5-gssapi)

NGX_CFLAGS="$NGX_CFLAGS $spnego_cflags"

ngx_feature="Heimdal Kerberos"
ngx_feature_name="heimdal_krb5"
ngx_feature_run=no
ngx_feature_incs="#include <krb5.h>"
ngx_feature_path=
ngx_feature_libs="$spnego_libs"
ngx_feature_test="krb5_context ctx = NULL; (void)krb5_get_err_text(ctx, 0)"
. auto/feature

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_auth_spnego_module
    ngx_module_srcs="$ngx_addon_dir/ngx_http_auth_spnego_module.c"
    ngx_module_libs="$spnego_libs"
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_auth_spnego_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_auth_spnego_module.c"
    CORE_LIBS="$CORE_LIBS $spnego_libs"
fi
