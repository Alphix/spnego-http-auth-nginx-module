			satisfy any;
			allow all;
			auth_gss_allow_basic_fallback on;
			auth_gss_delegation unconstrained;
			auth_gss_deleg_ccache_dir /var/lib/krb5_deleg_caches;
			fastcgi_param KRB5CCNAME \$krb5_cc_name;
		}
$(redirect_settings_locations redirect)
		location /redirect/header-same/ {
			index /header_bogus.php;
		}
		location /redirect/via-public/ {
			index /redirect/via-public/next;
