			index /header_bob_basic.php;
		}

		location = /delegate_copy_ok/check {
			set \$saved_ccache \$krb5_cc_name;
			satisfy any;
			allow all;
			include fastcgi_params;
			fastcgi_param SCRIPT_FILENAME /var/www/kerberos/delegate.php;
			fastcgi_param HTTP_AUTHORIZATION "";
			fastcgi_param KRB5CCNAME \$saved_ccache;
			fastcgi_pass unix:/run/php/php-fpm.sock;
		}
	}

	location /challenge_reuse/ {
		auth_gss on;
		auth_gss_realm ${KERBEROS_REALM};
		auth_gss_keytab /etc/krb5.http.keytab;
		auth_gss_service_name HTTP/${TEST_HOST_FQDN};
		auth_gss_allow_basic_fallback on;
		auth_gss_authorized_principal bob@${KERBEROS_REALM};
		auth_gss_format_full on;
		recursive_error_pages on;
		index /challenge_reuse/static;

		location = /challenge_reuse/static {
			auth_gss_format_full off;
			satisfy any;
			allow all;
			alias /var/www/kerberos/satisfyany;
			error_page 412 = /challenge_reuse/redirect;
		}

		location = /challenge_reuse/redirect {
			auth_gss off;
			error_page 302 /challenge_reuse/final;
			return 302 http://${TEST_HOST_FQDN}:8080/redirect-target;
		}

		location = /challenge_reuse/final {
			more_set_input_headers "Authorization: Basic $(printf %s "bob:${KRB_BOB_PW}" | base64 -w0)";
			alias /var/www/kerberos/satisfyany;
		}
	}

	location /delegate_deny_named/ {
$(delegation_settings alice)
                try_files \$uri @deny_copy_no_ccache;
