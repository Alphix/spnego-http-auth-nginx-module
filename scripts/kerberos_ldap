echo ""
echo "=== Session cookie tests ==="
echo ""

if [ "${SESSION_COOKIES}" = yes ]; then
	printf "Obtaining Kerberos ticket for alice ... "
	if kinit -kt krb5.alice.keytab alice; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi

	test_session_cookie "session.php" 8081 "alice@${KERBEROS_REALM}"

	# Test that a cookie-authenticated request survives an internal redirect to a
	# location that has cookies disabled but allow_basic_fallback on.  The module
	# must call save_login() after cookie auth so restore_login() can recover the
	# ctx on the redirected access check; without it the bogus Authorization header
	# written by set_bogus_authorization() would be parsed as Basic credentials and
	# rejected with 401. The cookie comes from session.php (same key and cookie
	# name), as a response after an internal redirect carries no Set-Cookie.
	printf "Session cookie auth survives redirect to no-cookie location ... "
	kinit -kt krb5.alice.keytab alice || die
	TMPHEADERS_REDIR="$(mktemp)"
	CODE="$(${CURL_NEGOTIATE} -D "${TMPHEADERS_REDIR}" -o "${CURL_OUTPUT}" \
		-w "%{http_code}" \
		"http://${TEST_HOST_FQDN}:8081/session.php")" || true
	COOKIE_REDIR_VAL="$(grep -i "^Set-Cookie: gss_session=" "${TMPHEADERS_REDIR}" \
		| head -1 \
		| sed 's/^[Ss][Ee][Tt]-[Cc][Oo][Oo][Kk][Ii][Ee]: gss_session=//i' \
		| sed 's/;.*//' | tr -d '\r')"
	rm -f "${TMPHEADERS_REDIR}"
	kdestroy -q > /dev/null 2>&1 || true
	CODE="$(${CURL_NONEGOTIATE} \
		-b "gss_session=${COOKIE_REDIR_VAL}" \
		-o "${CURL_OUTPUT}" -w "%{http_code}" \
		"http://${TEST_HOST_FQDN}:8081/cookie_redir.html")" || true
	if [ "${CODE}" = "200" ] && \
	   [ "$(cat "${CURL_OUTPUT}")" = "cookie_redirect_ok" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED (code=${CODE}, body=$(cat "${CURL_OUTPUT}" 2>/dev/null))"
	fi

	printf "Destroying Kerberos tickets ... "
	kdestroy -q > /dev/null 2>&1 || true
	echo "OK"

	# With no ticket and no valid cookie, session endpoint returns 401.
	echo ""
	echo "--- Session endpoint without ticket or cookie (expect 401/401) ---"
	test_path_on_port()
	{
		SUBURL="$1"
		PORT="$2"
		EXPECT1="$3"
		EXPECT2="$4"
		CURL_NEG="${5:-${CURL_NEGOTIATE}}"

		printf "curl port %s/%s, no negotiate (expect %s)=" "${PORT}" "${SUBURL}" "${EXPECT1}"
		rm -f "${CURL_OUTPUT}"
		CODE="$($CURL_NONEGOTIATE -w "%{http_code}" "http://${TEST_HOST_FQDN}:${PORT}/${SUBURL}")" || true
		printf "%s ... " "${CODE}"
		if [ "$CODE" = "${EXPECT1}" ]; then echo "OK"; else EX=1; echo "FAILED"; fi

		printf "curl port %s/%s, negotiate (expect %s)=" "${PORT}" "${SUBURL}" "${EXPECT2}"
		rm -f "${CURL_OUTPUT}"
		CODE="$($CURL_NEG -w "%{http_code}" "http://${TEST_HOST_FQDN}:${PORT}/${SUBURL}")" || true
		printf "%s ... " "${CODE}"
		if [ "$CODE" = "${EXPECT2}" ]; then echo "OK"; else EX=1; echo "FAILED"; fi
	}
	test_path_on_port "session.php" 8081 401 401
else
	echo "Skipping session cookie tests: AES-256-GCM-SIV unavailable"
fi


echo ""
echo "=== Channel binding tests ==="
echo ""

printf "Destroying Kerberos tickets ... "
kdestroy -q > /dev/null 2>&1 || true
echo "OK"

# Plain HTTP + auth_gss_channel_binding server-end-point: no TLS session
# exists so the module fails with a 500 error.
echo ""
echo "--- Channel binding directive on plain HTTP (expect 401/500) ---"
test_path "cbinding_sep.php" 401 401

printf "Obtaining Kerberos ticket for alice ... "
if kinit -kt krb5.alice.keytab alice; then
	echo "OK"
else
	EX=1
	echo "FAILED"
fi
test_path "cbinding_sep.php" 401 500

# HTTPS sanity: verify the TLS server is reachable before the CB tests.
echo ""
echo "--- HTTPS connectivity sanity check ---"
test_https_path "noauth.php" 200 200
test_https_path "cb_redirect/" 401 401

echo ""
echo "--- HTTPS + auth_gss_channel_binding server-end-point ---"
if curl_supports_channel_binding; then
	echo "    curl supports tls-server-end-point (curl >= 8.10.0 + OpenSSL)"
	# Unauthenticated: 401 challenge.
	# Authenticated with matching channel binding: 200.
	test_https_path "cbinding_sep.php" 401 200

	printf "Destroying Kerberos tickets ... "
	kdestroy -q > /dev/null 2>&1 || true
	echo "OK"

	# No ticket: both unauthenticated and negotiate return 401.
	test_https_path "cbinding_sep.php" 401 401
else
	echo "    curl does not support tls-server-end-point"
	echo "    (requires curl >= 8.10.0 built against OpenSSL;"
	echo "     see https://github.com/curl/curl/pull/13098)"
	# Unauthenticated: 401 challenge.
	# Authenticated without a channel binding: GSS_C_CHANNEL_BOUND_FLAG not
	# set, rejected with 403 (allow_basic_fallback is off).
	test_https_path "cbinding_sep.php" 401 403
fi

echo ""
echo "--- HTTPS + auth_gss_channel_binding exporter (always 401/403) ---"
echo "    No mainstream client sends tls-exporter channel binding for HTTP Negotiate."
# Re-obtain ticket if it was destroyed above.
if ! klist -s > /dev/null 2>&1; then
	printf "Obtaining Kerberos ticket for alice ... "
	if kinit -kt krb5.alice.keytab alice; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi
fi
# Unauthenticated: 401 challenge.
# Authenticated: GSS_C_CHANNEL_BOUND_FLAG never set (no client sends
# tls-exporter); rejected with 403.
test_https_path "cbinding_exp.php" 401 403

printf "Destroying Kerberos tickets ... "
kdestroy -q > /dev/null 2>&1 || true
echo "OK"

# No ticket: both unauthenticated and negotiate return 401.
test_https_path "cbinding_exp.php" 401 401


echo ""
if [ "${EX}" -ne 0 ]; then
	echo "=== journalctl nginx ==="
	journalctl -n all -xu nginx.service || true

	echo "=== /etc/nginx/sites-available/kerberos ==="
	cat /etc/nginx/sites-available/kerberos

	echo "=== error.log ==="
	cat /var/log/nginx/error.log

	echo "=== access.log ==="
	cat /var/log/nginx/access.log

	echo "=== journalctl slapd ==="
	journalctl -n all -xu slapd.service || true

	echo "=== slapcat ==="
	slapcat

	echo "=== ldapwhoami ==="
	ldapwhoami -Y GSSAPI -v -H "ldap://${TEST_HOST_FQDN}/"

	echo "=== klist ==="
	klist

	echo "=== /etc/krb* ==="
	ls -al /etc/krb*
fi

exit ${EX}
