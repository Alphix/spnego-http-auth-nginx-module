# HTTPS server for channel binding tests.
server {
	listen ${HTTPS_PORT} ssl;
	listen [::]:${HTTPS_PORT} ssl;

	ssl_certificate     /etc/nginx/ssl/cb_test.crt;
	ssl_certificate_key /etc/nginx/ssl/cb_test.key;
	ssl_protocols       TLSv1.2 TLSv1.3;

	root /var/www/kerberos;

	server_name ${TEST_HOST_FQDN};

	# Sanity check: plain HTTPS connectivity, no auth.
	location /noauth.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
		auth_gss off;
	}

	# RFC 5929 tls-server-end-point binding: clients must send matching
	# channel binding or are rejected with 403.
	location /cbinding_sep.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback off;
                auth_gss_authorized_principal alice@${KERBEROS_REALM};
                auth_gss_format_full on;
                fastcgi_param HTTP_AUTHORIZATION "";
                auth_gss_channel_binding server-end-point;
	}

	# RFC 9266 tls-exporter binding: no mainstream client supports this
	# for HTTP Negotiate, so all authenticated requests are rejected with 403.
	location /cbinding_exp.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback off;
                auth_gss_authorized_principal alice@${KERBEROS_REALM};
                auth_gss_format_full on;
                fastcgi_param HTTP_AUTHORIZATION "";
                auth_gss_channel_binding exporter;
	}

	location /cb_redirect/ {
		auth_gss on;
		auth_gss_realm ${KERBEROS_REALM};
		auth_gss_keytab /etc/krb5.http.keytab;
		auth_gss_service_name HTTP/${TEST_HOST_FQDN};
		auth_gss_allow_basic_fallback off;
		auth_gss_format_full on;
		index /cbinding_sep.php;
	}
}
server {
	listen 127.0.0.1:8082;

	location = /ccache_check {
		add_header X-Ccache \$http_x_ccache always;
		add_header X-Copied-Ccache \$http_x_copied_ccache always;
		return 200 "backend\n";
	}
}

server {
	listen 8083;
	listen [::]:8083;
	server_name ${TEST_HOST_FQDN};
	root /var/www/kerberos;
	auth_gss on;
	auth_gss_realm ${KERBEROS_REALM};
	auth_gss_keytab /etc/krb5.http.keytab;
	auth_gss_service_name HTTP/${TEST_HOST_FQDN};
	auth_gss_allow_basic_fallback off;
	auth_gss_authorized_principal alice@${KERBEROS_REALM};
	auth_gss_format_full on;
	auth_gss_delegation off;
	set \$early_ccache \$krb5_cc_name;

	location /server_rewrite_ccache/ {
		${DELEGATION_DIRECTIVE}
		auth_gss_deleg_ccache_dir /var/lib/krb5_deleg_caches;
		index /public.php;

		location /server_rewrite_ccache/clear/ {
			index /server_rewrite_ccache/cleared;
		}

		location = /server_rewrite_ccache/cleared {
			more_clear_input_headers Authorization;
			error_page 401 = /public.php;
		}
	}

	location = /public.php {
		auth_gss off;
		proxy_set_header Authorization "";
		proxy_set_header X-Ccache \$early_ccache;
		proxy_pass http://127.0.0.1:8082/ccache_check;
	}
}


# BEGIN session cookie server
# HTTP server for session cookie tests (separate port 8081 so cookie tests
# don't interfere with the main test flow).
server {
	listen 8081;
	listen [::]:8081;

	root /var/www/kerberos;
	server_name ${TEST_HOST_FQDN};

	# Session cookie endpoint: first request uses SPNEGO, subsequent requests
	# are authenticated from the encrypted session cookie.
	location /session.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
		auth_gss on;
		auth_gss_realm ${KERBEROS_REALM};
		auth_gss_keytab /etc/krb5.http.keytab;
		auth_gss_service_name HTTP/${TEST_HOST_FQDN};
		auth_gss_allow_basic_fallback off;
		auth_gss_authorized_principal alice@${KERBEROS_REALM};
		auth_gss_format_full on;
		fastcgi_param HTTP_AUTHORIZATION "";
		fastcgi_param REMOTE_USER \$remote_user;
		fastcgi_param SESSION_PRINCIPAL \$krb5_session_principal;
		# 64-char hex AES-256 key shared across the cluster
		auth_gss_session_key "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20";
		auth_gss_session_cookie_name gss_session;
		auth_gss_session_expiry 3600;
	}

	# Cookie-then-redirect: access check at /cookie_redir.html uses session
	# cookie; try_files redirects internally to @cookie_redir_target which
	# has no cookie config and allow_basic_fallback on.  Tests that
	# save_login() is called after cookie auth so the ctx survives the
	# internal redirect (without it the bogus Authorization header would be
	# parsed as Basic auth and rejected). The target serves a static file
	# rather than using "return", which would answer before the access phase.
	location = /cookie_redir.html {
		auth_gss on;
		auth_gss_realm ${KERBEROS_REALM};
		auth_gss_keytab /etc/krb5.http.keytab;
		auth_gss_service_name HTTP/${TEST_HOST_FQDN};
		auth_gss_allow_basic_fallback off;
		auth_gss_session_key "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20";
		auth_gss_session_cookie_name gss_session;
		auth_gss_session_expiry 3600;
		try_files /NONEXISTENT @cookie_redir_target;
	}
	location @cookie_redir_target {
		auth_gss on;
		auth_gss_realm ${KERBEROS_REALM};
		auth_gss_keytab /etc/krb5.http.keytab;
		auth_gss_service_name HTTP/${TEST_HOST_FQDN};
		auth_gss_allow_basic_fallback on;
		default_type text/plain;
		rewrite ^ /cookie_redirect_ok break;
	}
}
# END session cookie server
EOF
then
	die
fi
if [ "${SESSION_COOKIES}" != yes ]; then
	sed -i '/^# BEGIN session cookie server$/,/^# END session cookie server$/d' \
		/etc/nginx/sites-available/kerberos || die
fi
ln -s /etc/nginx/sites-available/kerberos /etc/nginx/sites-enabled/ || die
mkdir -p /var/www/kerberos || die
cp "${WORKSPACE_DIR}/contrib/nginx-tmpfiles.conf" /etc/tmpfiles.d/nginx-ccaches.conf || die
systemd-tmpfiles --create /etc/tmpfiles.d/nginx-ccaches.conf || die
echo "OK"


