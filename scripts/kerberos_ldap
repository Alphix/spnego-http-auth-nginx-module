<?php
	if (!isset(\$_SERVER["REMOTE_USER"]) || \$_SERVER["REMOTE_USER"] == "") {
		http_response_code(500);
		echo("REMOTE_USER not set");
		exit();
	}
	if (!isset(\$_SERVER["KRB5_EXPORTED_CRED"]) || \$_SERVER["KRB5_EXPORTED_CRED"] == "") {
		http_response_code(500);
		echo("KRB5_EXPORTED_CRED not set");
		exit();
	}
	// Validate that nginx did NOT inject a ready-made KRB5CCNAME; the point
	// of this test is that the backend derives everything from the blob.
	if (!empty(\$_SERVER["KRB5CCNAME"])) {
		http_response_code(500);
		echo("KRB5CCNAME must not be set for in-memory export test");
		exit();
	}
	\$blob = base64_decode(\$_SERVER["KRB5_EXPORTED_CRED"], true);
	if (\$blob === false || strlen(\$blob) == 0) {
		http_response_code(500);
		echo("KRB5_EXPORTED_CRED is not valid base64");
		exit();
	}
	if (!extension_loaded('krb5')) {
		http_response_code(500);
		echo("krb5 extension not loaded");
		exit();
	}
	\$ctx = new GSSAPIContext();
	if (!\$ctx->importCredentials(\$blob)) {
		http_response_code(500);
		echo("importCredentials() failed");
		exit();
	}
	\$ccname = "MEMORY:export_check_" . getmypid();
	if (!\$ctx->storeCredentials(\$ccname)) {
		http_response_code(500);
		echo("storeCredentials() failed");
		exit();
	}
	putenv("KRB5CCNAME=" . \$ccname);
	\$conn = ldap_connect("ldap://${TEST_HOST_FQDN}/");
	if (!\$conn) {
		http_response_code(500);
		echo("ldap_connect() failed");
		exit();
	}
	if (!ldap_set_option(\$conn, LDAP_OPT_PROTOCOL_VERSION, 3)) {
		http_response_code(500);
		echo("ldap_set_option() failed");
		exit();
	}
	\$r = ldap_sasl_bind(\$conn);
	if (!\$r) {
		http_response_code(500);
		echo("ldap_sasl_bind() failed: " . ldap_error(\$conn));
		if (ldap_get_option(\$conn, LDAP_OPT_DIAGNOSTIC_MESSAGE, \$ext_err)) {
			echo(" (" . \$ext_err . ")");
		}
		exit();
	}
	\$who = ldap_exop_whoami(\$conn);
	if (!\$who) {
		http_response_code(500);
		echo("ldap_exop_whoami() failed");
		exit();
	}
	echo(\$who);
?>
EOF
then
	die
fi
echo "OK"

