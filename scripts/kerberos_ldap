# Test session cookie authentication:
# 1. First request: SPNEGO auth; expect 200 and a Set-Cookie header.
# 2. Destroy Kerberos tickets so subsequent requests have no client creds.
# 3. Cookie-only request (no Negotiate header); expect 200.
# 4. Verify body matches "Authenticated as <user>".
# 5. Verify a tampered cookie is rejected.
# Usage: test_session_cookie <suburl> <port> <expected_user> [cookie_name]
test_session_cookie()
{
	SUBURL="$1"
	PORT="${2:-8081}"
	EXPECTED_USER="$3"
	COOKIE_NAME="${4:-gss_session}"
	EXPECTED_BODY="Authenticated as ${EXPECTED_USER}"
	TMPHEADERS="$(mktemp)"

	printf "curl port %s/%s, session SPNEGO (expect 200+Set-Cookie)=" \
		"${PORT}" "${SUBURL}"
	rm -f "${CURL_OUTPUT}"
	CODE="$(${CURL_NEGOTIATE} -D "${TMPHEADERS}" -o "${CURL_OUTPUT}" \
		-w "%{http_code}" \
		"http://${TEST_HOST_FQDN}:${PORT}/${SUBURL}")" || true
	printf "%s ... " "${CODE}"
	if [ "${CODE}" != "200" ]; then
		EX=1
		echo "FAILED"
		if [ -e "${CURL_OUTPUT}" ]; then cat "${CURL_OUTPUT}"; echo ""; fi
		rm -f "${TMPHEADERS}"
		return
	fi
	echo "OK"

	COOKIE_VAL="$(grep -i "^Set-Cookie: ${COOKIE_NAME}=" "${TMPHEADERS}" \
		| head -1 | sed "s/^[Ss][Ee][Tt]-[Cc][Oo][Oo][Kk][Ii][Ee]: ${COOKIE_NAME}=//i" \
		| sed 's/;.*//' | tr -d '\r')"
	rm -f "${TMPHEADERS}"

	printf "Set-Cookie: %s=<value> present ... " "${COOKIE_NAME}"
	if [ -z "${COOKIE_VAL}" ]; then
		EX=1
		echo "FAILED"
		return
	fi
	echo "OK"

	printf "Destroying Kerberos tickets before cookie-only test ... "
	kdestroy -q > /dev/null 2>&1 || true
	echo "OK"

	printf "curl port %s/%s, cookie-only, no Kerberos ticket (expect 200)=" "${PORT}" "${SUBURL}"
	rm -f "${CURL_OUTPUT}"
	CODE="$(${CURL_NONEGOTIATE} \
		-b "${COOKIE_NAME}=${COOKIE_VAL}" \
		-o "${CURL_OUTPUT}" -w "%{http_code}" \
		"http://${TEST_HOST_FQDN}:${PORT}/${SUBURL}")" || true
	printf "%s ... " "${CODE}"
	if [ "${CODE}" = "200" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
		if [ -e "${CURL_OUTPUT}" ]; then cat "${CURL_OUTPUT}"; echo ""; fi
		return
	fi

	printf "Cookie auth body='%s' (expect='%s') ... " \
		"$(cat "${CURL_OUTPUT}" 2>/dev/null)" "${EXPECTED_BODY}"
	if [ "$(cat "${CURL_OUTPUT}" 2>/dev/null)" = "${EXPECTED_BODY}" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi

	printf "curl port %s/%s, tampered cookie (expect 401)=" \
		"${PORT}" "${SUBURL}"
	rm -f "${CURL_OUTPUT}"
	CODE="$(${CURL_NONEGOTIATE} \
		-b "${COOKIE_NAME}=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" \
		-o "${CURL_OUTPUT}" -w "%{http_code}" \
		"http://${TEST_HOST_FQDN}:${PORT}/${SUBURL}")" || true
	printf "%s ... " "${CODE}"
	if [ "${CODE}" = "401" ]; then
		echo "OK"
	else
		EX=1
		echo "FAILED"
	fi
}


printf "Destroying Kerberos tickets ... "
kdestroy -q > /dev/null 2>&1 || true
echo "OK"
test_basic "fallback.php" 401 200
