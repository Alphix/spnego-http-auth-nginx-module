#!/bin/sh

# Test that regular authentication is working, and that constrained delegation
# is working. In order for this to be doable, we set up a Kerberos KDC with
# a LDAP-based backend (the LDAP DB driver has support for the necessesary
# hooks that enable constrained delegation, the standard MIT DB2 backend does
# not). Furthermore, we use a simple PHP script to demonstrate the delegation
# by connecting to the LDAP server using the client principals passed in via
# the HTTP connection.
#
# Note that this script is written to be usable both in autopkgtest and Github
# workflows (which also implies that it needs to be compatible with Debian and
# Ubuntu).
#
# Copyright (C) 2025 David Härdeman <david@hardeman.nu>

EX=0
CURL_OUTPUT="http_body"
CURL_NONEGOTIATE="curl --max-time 60 --silent --fail-with-body -o ${CURL_OUTPUT}"
CURL_NEGOTIATE="${CURL_NONEGOTIATE} --negotiate -u :"
CURL_NEGOTIATE_DELEGATE="${CURL_NEGOTIATE} --delegation policy"
CURL_HTTPS_NONEGOTIATE="${CURL_NONEGOTIATE} --insecure"
CURL_HTTPS_NEGOTIATE="${CURL_NEGOTIATE} --insecure"
HTTPS_PORT="8443"
DOMAIN="example.com"
TEST_HOST="server"
TEST_HOST_FQDN="${TEST_HOST}.${DOMAIN}"
LDAP_BASE_DN="$(echo "${DOMAIN}" | sed 's/\./,/;s/\([^,]\+\)/dc=\1/g')"
LDAP_SERVICES_DN="ou=Services,${LDAP_BASE_DN}"
LDAP_KRB_DN="ou=kerberos,${LDAP_SERVICES_DN}"
LDAP_KRB_CONTAINER_DN="cn=krbContainer,${LDAP_KRB_DN}"
LDAP_KDC_DN="uid=kdc,${LDAP_KRB_DN}"
LDAP_KDC_PW="kdctest"
LDAP_KADMIN_DN="uid=kadmin,${LDAP_KRB_DN}"
LDAP_KADMIN_PW="kadmintest"
LDAP_ADMIN_DN="cn=admin,${LDAP_BASE_DN}"
LDAP_ADMIN_PW="test"
LDAP_HTTP_DN="uid=http,${LDAP_SERVICES_DN}"
LDAP_HTTP_PW="httptest"
KRB_BOB_PW="bob@BOB@123"
KERBEROS_REALM="$(echo "${DOMAIN}" | tr "[:lower:]" "[:upper:]")"
export LC_ALL=C
export DEBIAN_FRONTEND=noninteractive


die()
{
	echo "FAILED"
	exit 1
}

# Resolve the repo root (parent of scripts/) before any cd changes the cwd.
WORKSPACE_DIR="$(cd "$(dirname -- "$0")/.." && pwd)"

# Resolve the repo root (parent of scripts/) before any cd changes the cwd.
WORKSPACE_DIR="$(cd "$(dirname -- "$0")/.." && pwd)"

if [ -n "${AUTOPKGTEST_TMP}" ]; then
	cd "${AUTOPKGTEST_TMP}" || exit 1
elif [ -n "${GITHUB_WORKSPACE}" ]; then
	# Yeah, this env variable won't be passed on by sudo...
	cd "${GITHUB_WORKSPACE}" || exit 1
fi

# Detect whether the installed module supports constrained delegation.
# Constrained delegation requires gss_acquire_cred_from() with a client_keytab
# GSS store element to acquire the service TGT for S4U2Proxy.  We detect this
# by checking for the "client_keytab" string literal that is only present in
# the constrained delegation code path.
if strings /usr/lib/nginx/modules/ngx_http_auth_spnego_module.so \
       2>/dev/null | grep -qF "client_keytab"; then
    HAS_CONSTRAINED_DELEGATION=yes
else
    HAS_CONSTRAINED_DELEGATION=no
fi


cat <<EOF
Test Configuration
==============================================================================
Dir				: $(pwd)
Domain				: ${DOMAIN}
Kerberos realm			: ${KERBEROS_REALM}
Host FQDN			: ${TEST_HOST_FQDN}
LDAP base DN			: ${LDAP_BASE_DN}
LDAP services DN		: ${LDAP_SERVICES_DN}
LDAP kerberos DN		: ${LDAP_KRB_DN}
LDAP kerberos container DN	: ${LDAP_KRB_CONTAINER_DN}
LDAP KDC DN			: ${LDAP_KDC_DN}
LDAP KDC PW			: ${LDAP_KDC_PW}
LDAP kadmin DN			: ${LDAP_KADMIN_DN}
LDAP kadmin PW			: ${LDAP_KADMIN_PW}
LDAP admin DN			: ${LDAP_ADMIN_DN}
LDAP admin PW			: ${LDAP_ADMIN_PW}
LDAP HTTP DN			: ${LDAP_HTTP_DN}
LDAP HTTP PW			: ${LDAP_HTTP_PW}
KRB bob PW			: ${KRB_BOB_PW}
==============================================================================
EOF


echo ""
echo "=== Initial setup ==="
echo ""
printf "Setting host FQDN to %s ... " "${TEST_HOST_FQDN}"
echo "127.0.0.1 ${TEST_HOST_FQDN} ${TEST_HOST}" >> /etc/hosts || die
if ! hostnamectl hostname "${TEST_HOST_FQDN}"; then
	if ! echo "${TEST_HOST_FQDN}" >> /etc/hostname; then
		echo "FAILED (but continuing anyway)"
	else
		echo "OK"
	fi
else
	echo "OK"
fi


printf "Reconfiguring slapd ... "
if ! debconf-set-selections <<EOF
slapd slapd/password1 password ${LDAP_ADMIN_PW}
slapd slapd/password2 password ${LDAP_ADMIN_PW}
slapd slapd/domain string ${DOMAIN}
slapd shared/organization string FooBarCorp
EOF
then
	die
fi
dpkg-reconfigure slapd > /dev/null 2>&1 || die
echo "OK"


printf "Verifying LDAP base DN ... "
CFG_DOMAIN="$(ldapsearch -x -LLL -s base -b "" namingContexts | grep namingContexts | cut -d" " -f2)"
if [ "${CFG_DOMAIN}" != "${LDAP_BASE_DN}" ]; then
	printf "%s != %s ... " "${CFG_DOMAIN}" "${LDAP_BASE_DN}"
	die
fi
echo "${CFG_DOMAIN} ... OK"


printf "Enabling LDAP logging ... "
if ! ldapmodify -Q -H ldapi:/// -Y EXTERNAL > /dev/null <<EOF
dn: cn=config
changetype: modify
replace: olcLogLevel
olcLogLevel: stats
EOF
then
	die
fi
echo "OK"


printf "Adding Kerberos schema to LDAP ... "
zcat /usr/share/doc/krb5-kdc-ldap/kerberos.openldap.ldif.gz | \
	ldapadd -Q -Y EXTERNAL -H ldapi:/// > /dev/null || die
echo "OK"


printf "Loading memberOf overlay module ... "
if ! ldapmodify -Q -Y EXTERNAL -H ldapi:/// > /dev/null 2>&1 <<EOF
dn: cn=module{0},cn=config
changetype: modify
add: olcModuleLoad
olcModuleLoad: memberof
EOF
then
	ldapadd -Q -Y EXTERNAL -H ldapi:/// > /dev/null <<EOF || die
dn: cn=module,cn=config
objectClass: olcModuleList
cn: module
olcModuleLoad: memberof
EOF
fi
echo "OK"


printf "Creating basic Kerberos LDAP structure ... "
if ! ldapadd -x -D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" > /dev/null <<EOF
dn: ${LDAP_SERVICES_DN}
objectClass: organizationalUnit
ou: Services

dn: ${LDAP_KRB_DN}
objectClass: organizationalUnit
ou: kerberos

dn: ${LDAP_KDC_DN}
uid: kdc
objectClass: account
objectClass: simpleSecurityObject
userPassword: {CRYPT}x
description: Kerberos KDC Account

dn: ${LDAP_KADMIN_DN}
uid: kadmin
objectClass: account
objectClass: simpleSecurityObject
userPassword: {CRYPT}x
description: Kerberos Admin Server Account
EOF
then
	die
fi
echo "OK"


printf "Setting LDAP password for KDC ... "
ldappasswd -x -D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" \
	-s "${LDAP_KDC_PW}" "${LDAP_KDC_DN}" || die
echo "OK"


printf "Setting LDAP password for kadmin ... "
ldappasswd -x -D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" \
	-s "${LDAP_KADMIN_PW}" "${LDAP_KADMIN_DN}" || die
echo "OK"


printf "Setting LDAP ACLs for KDC and kadmin ... "
if ! ldapmodify -Q -Y EXTERNAL -H ldapi:/// > /dev/null <<EOF
dn: olcDatabase={1}mdb,cn=config
add: olcAccess
olcAccess: {0}to attrs=krbPrincipalKey
  by anonymous auth
  by dn.exact="${LDAP_KDC_DN}" read
  by dn.exact="${LDAP_KADMIN_DN}" write
  by self write
  by * none
-
add: olcAccess
olcAccess: {1}to dn.subtree="${LDAP_KRB_CONTAINER_DN}"
  by dn.exact="${LDAP_KDC_DN}" read
  by dn.exact="${LDAP_KADMIN_DN}" write
  by * none
EOF
then
	die
fi
echo "OK"


printf "Creating People OU, Groups OU, user entries, and HTTP service account ... "
if ! ldapadd -x -D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" > /dev/null <<EOF
dn: ou=People,${LDAP_BASE_DN}
objectClass: organizationalUnit
ou: People

dn: ou=Groups,${LDAP_BASE_DN}
objectClass: organizationalUnit
ou: Groups

dn: uid=alice,ou=People,${LDAP_BASE_DN}
objectClass: inetOrgPerson
uid: alice
cn: Alice
sn: Test

dn: uid=mallory,ou=People,${LDAP_BASE_DN}
objectClass: inetOrgPerson
uid: mallory
cn: Mallory
sn: Test

dn: uid=bob,ou=People,${LDAP_BASE_DN}
objectClass: inetOrgPerson
uid: bob
cn: Bob
sn: Test

dn: ${LDAP_HTTP_DN}
uid: http
objectClass: account
objectClass: simpleSecurityObject
userPassword: {CRYPT}x
description: nginx service account for LDAP group lookups
EOF
then
	die
fi
echo "OK"


printf "Configuring memberOf overlay ... "
if ! ldapadd -Q -Y EXTERNAL -H ldapi:/// > /dev/null <<EOF
dn: olcOverlay=memberof,olcDatabase={1}mdb,cn=config
objectClass: olcOverlayConfig
objectClass: olcMemberOf
olcOverlay: memberof
olcMemberOfDangling: ignore
olcMemberOfRefInt: TRUE
olcMemberOfGroupOC: groupOfNames
olcMemberOfMemberAD: member
olcMemberOfMemberOfAD: memberOf
EOF
then
	die
fi
echo "OK"


printf "Creating webusers authorization group ... "
if ! ldapadd -x -D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" > /dev/null <<EOF
dn: cn=webusers,ou=Groups,${LDAP_BASE_DN}
objectClass: groupOfNames
cn: webusers
member: uid=alice,ou=People,${LDAP_BASE_DN}
EOF
then
	die
fi
echo "OK"


printf "Setting LDAP password for HTTP service account ... "
ldappasswd -x -D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" \
	-s "${LDAP_HTTP_PW}" "${LDAP_HTTP_DN}" || die
echo "OK"


printf "Granting KDC, kadmin, and HTTP service account access to People OU ... "
if ! ldapmodify -Q -Y EXTERNAL -H ldapi:/// > /dev/null <<EOF
dn: olcDatabase={1}mdb,cn=config
changetype: modify
add: olcAccess
olcAccess: {2}to dn.subtree="ou=People,${LDAP_BASE_DN}"
  by dn.exact="${LDAP_KDC_DN}" read
  by dn.exact="${LDAP_KADMIN_DN}" write
  by dn.exact="${LDAP_HTTP_DN}" read
  by dn.subtree="cn=gssapi,cn=auth" read
  by dn.subtree="cn=gss-spnego,cn=auth" read
  by * none
EOF
then
	die
fi
echo "OK"


printf "Writing /etc/krb5.conf ... "
if ! cat <<EOF > /etc/krb5.conf
[libdefaults]
        default_realm = ${KERBEROS_REALM}
        dns_lookup_realm = false
        dns_lookup_kdc = false
        ticket_lifetime = 24h
        forwardable = true
        proxiable = true
        rdns = false

[realms]
        ${KERBEROS_REALM} = {
                kdc = ${TEST_HOST_FQDN}
                admin_server = ${TEST_HOST_FQDN}
                default_domain = ${DOMAIN}
                # Custom mapping for the auth_gss_map_to_local Basic-auth test:
                # bob -> bobmapped, everything else uses the default mapping.
                auth_to_local = RULE:[1:\$1](bob)s/bob/bobmapped/
                auth_to_local = DEFAULT
        }
EOF
then
	die
fi
echo "OK"


printf "Writing /etc/krb5kdc/kdc.conf ... "
if ! cat <<EOF > /etc/krb5kdc/kdc.conf
[realms]
        ${KERBEROS_REALM} = {
                database_module = openldap_ldapconf
        }

[dbmodules]
        openldap_ldapconf = {
                db_library = kldap

                ldap_kerberos_container_dn = ${LDAP_KRB_CONTAINER_DN}

                # if either of these is false, then the ldap_kdc_dn needs to
                # have write access as explained above
                disable_last_success = true
                disable_lockout = true
                ldap_conns_per_server = 5
                ldap_servers = ldapi:///

                # this object needs to have read rights on
                # the realm container, principal container and realm sub-trees
                ldap_kdc_dn = "${LDAP_KDC_DN}"

                # this object needs to have read and write rights on
                # the realm container, principal container and realm sub-trees
                ldap_kadmind_dn = "${LDAP_KADMIN_DN}"

                # this file will be used to store plaintext passwords used
                # to connect to the LDAP server
                ldap_service_password_file = /etc/krb5kdc/service.keyfile

                # OR, comment out ldap_kdc_dn, ldap_kadmind_dn and
                # ldap_service_password_file above and enable the following
                # two lines, if you skipped the step of creating entries/users
                # for the Kerberos servers

                #ldap_kdc_sasl_mech = EXTERNAL
                #ldap_kadmind_sasl_mech = EXTERNAL
                #ldap_servers = ldapi:///
        }
EOF
then
	die
fi
echo "OK"


printf "Writing /etc/krb5kdc/kadm5.acl ... "
if ! cat <<EOF > /etc/krb5kdc/kadm5.acl
*/admin@${KERBEROS_REALM}        *
EOF
then
	die
fi
echo "OK"


# This will create two new entries in the LDAP DIT:
#   ${LDAP_KRB_CONTAINER_DN}
#   cn=${KERBEROS_REALM},${LDAP_KRB_CONTAINER_DN}
# e.g.:
#   cn=krbContainer,ou=kerberos,ou=Services,dc=example,dc=com
#   cn=EXAMPLE.COM,cn=krbContainer,ou=kerberos,ou=Services,dc=example,dc=com
printf "Creating Kerberos realm %s ... " "${KERBEROS_REALM}"
kdb5_ldap_util -D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" -P kdcmasterpw \
	create -subtrees "${LDAP_BASE_DN}" -r "${KERBEROS_REALM}" -s -H ldapi:/// \
	> /dev/null || die
echo "OK"


printf "Stashing KDC password ... "
printf "%s\n%s\n" "${LDAP_KDC_PW}" "${LDAP_KDC_PW}" | kdb5_ldap_util \
	-D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" \
	stashsrvpw -f /etc/krb5kdc/service.keyfile \
	"${LDAP_KDC_DN}" \
	> /dev/null || die
echo "OK"


printf "Stashing kadmin password ... "
printf "%s\n%s\n" "${LDAP_KADMIN_PW}" "${LDAP_KADMIN_PW}" | kdb5_ldap_util \
	-D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" \
	stashsrvpw -f /etc/krb5kdc/service.keyfile \
	"${LDAP_KADMIN_DN}" \
	> /dev/null || die
echo "OK"


printf "Restarting KDC ... "
invoke-rc.d krb5-kdc restart || die
echo "OK"


printf "Restarting kadmind ... "
invoke-rc.d krb5-admin-server restart || die
echo "OK"


printf "Creating default Kerberos password policy ... "
kadmin.local -q "addpol -minlength 1 defaultpol" > /dev/null || die
echo "OK"


printf "Creating test user principals ... "
rm -f krb5.alice.keytab krb5.mallory.keytab
kadmin.local -q "addprinc -randkey -policy defaultpol -x dn=uid=alice,ou=People,${LDAP_BASE_DN} alice" > /dev/null || die
kadmin.local -q "ktadd -k krb5.alice.keytab alice" > /dev/null || die
kadmin.local -q "addprinc -pw ${KRB_BOB_PW} -policy defaultpol -x dn=uid=bob,ou=People,${LDAP_BASE_DN} bob" > /dev/null || die
kadmin.local -q "addprinc -randkey -policy defaultpol -x dn=uid=mallory,ou=People,${LDAP_BASE_DN} mallory" > /dev/null || die
kadmin.local -q "ktadd -k krb5.mallory.keytab mallory" > /dev/null || die
echo "OK"


printf "Creating LDAP server principal ... "
kadmin.local -q "addprinc -randkey -policy defaultpol ldap/${TEST_HOST_FQDN}" > /dev/null || die
kadmin.local -q "ktadd -k /etc/krb5.ldap.keytab ldap/${TEST_HOST_FQDN}" > /dev/null || die
chown root:openldap /etc/krb5.ldap.keytab || die
chmod 0640 /etc/krb5.ldap.keytab || die
sed -i '/KRB5_KTNAME=/d' /etc/default/slapd || die
# sysv init
echo "export KRB5_KTNAME=/etc/krb5.ldap.keytab" >> /etc/default/slapd
# systemd
echo "KRB5_KTNAME=/etc/krb5.ldap.keytab" >> /etc/default/slapd
echo "OK"


printf "Updating apparmor profile for slapd ... "
if [ -e /etc/apparmor.d/usr.sbin.slapd ]; then
	mkdir -p /etc/apparmor.d/local
	echo "/etc/krb5.ldap.keytab kr," >> /etc/apparmor.d/local/usr.sbin.slapd
	apparmor_parser -r /etc/apparmor.d/usr.sbin.slapd
fi
echo "OK"


printf "Restarting slapd ... "
invoke-rc.d slapd restart || die
echo "OK"


printf "Creating HTTP server principal ... "
kadmin.local -q "addprinc -randkey -policy defaultpol HTTP/${TEST_HOST_FQDN}" > /dev/null || die
kadmin.local -q "modprinc +ok_as_delegate HTTP/${TEST_HOST_FQDN}" > /dev/null || die
kadmin.local -q "modprinc +ok_to_auth_as_delegate HTTP/${TEST_HOST_FQDN}" > /dev/null || die
kadmin.local -q "ktadd -k /etc/krb5.http.keytab HTTP/${TEST_HOST_FQDN}" > /dev/null || die
chown root:www-data /etc/krb5.http.keytab || die
chmod 0640 /etc/krb5.http.keytab || die
echo "OK"


printf "Creating nginx Kerberos ccache for LDAP GSSAPI bind ... "
rm -f /tmp/krb5cc_nginx
kinit -kt /etc/krb5.http.keytab "HTTP/${TEST_HOST_FQDN}" -c /tmp/krb5cc_nginx || die
chown www-data:www-data /tmp/krb5cc_nginx || die
echo "OK"


printf "Setting delegation permissions via LDAP ... "
if ! ldapmodify -x -D "${LDAP_ADMIN_DN}" -w "${LDAP_ADMIN_PW}" > /dev/null <<EOF
dn: krbPrincipalName=HTTP/${TEST_HOST_FQDN}@${KERBEROS_REALM},cn=${KERBEROS_REALM},${LDAP_KRB_CONTAINER_DN}
changetype: modify
replace: krbAllowedToDelegateTo
krbAllowedToDelegateTo: ldap/${TEST_HOST_FQDN}@${KERBEROS_REALM}
EOF
then
	die
fi
echo "OK"


printf "Generating self-signed TLS certificate for channel binding tests ... "
mkdir -p /etc/nginx/ssl || die
openssl req -x509 -nodes -newkey rsa:2048 \
	-keyout /etc/nginx/ssl/cb_test.key \
	-out /etc/nginx/ssl/cb_test.crt \
	-days 365 \
	-subj "/CN=${TEST_HOST_FQDN}" > /dev/null 2>&1 || die
echo "OK"


# The Authorization header checks require the headers-more module.
printf "Checking for the headers-more module ... "
if ! grep -qs 'load_module modules/ngx_http_headers_more_filter_module.so;' /etc/nginx/modules-enabled/*; then
	printf 'load_module modules/ngx_http_headers_more_filter_module.so;\n' > /etc/nginx/modules-enabled/50-headers-more-test.conf || die
fi
echo "OK"


# Each destination changes one setting. Sharing the configuration and request
# table keeps these comparisons from needing separate PHP pages and test blocks.
REDIRECT_SETTINGS="$(cat <<EOF
redirect keytab auth_gss_keytab /etc/krb5.keytab
redirect keytab-longer auth_gss_keytab /etc/krb5.http.keytab.copy
redirect keytab-same-length auth_gss_keytab /etc/krb5.copy.keytab
redirect realm auth_gss_realm OTHER.COM
redirect realm-longer auth_gss_realm ${KERBEROS_REALM}.OTHER
redirect realm-case auth_gss_realm ${DOMAIN}
redirect service auth_gss_service_name HTTP/other.${TEST_HOST_FQDN}
redirect service-empty auth_gss_service_name ""
redirect format auth_gss_format_full off
redirect map auth_gss_map_to_local on
redirect delegate auth_gss_delegation unconstrained; auth_gss_deleg_ccache_dir /var/lib/krb5_deleg_caches
delegate_chain constrained auth_gss_delegation unconstrained
delegate_chain service-empty auth_gss_service_name ""
EOF
)"

delegation_settings()
{
	cat <<EOF
		auth_gss on;
		auth_gss_realm ${KERBEROS_REALM};
		auth_gss_keytab /etc/krb5.http.keytab;
		auth_gss_service_name HTTP/${TEST_HOST_FQDN};
		auth_gss_allow_basic_fallback off;
		auth_gss_authorized_principal $1@${KERBEROS_REALM};
		auth_gss_format_full on;
		${DELEGATION_DIRECTIVE}
		auth_gss_deleg_ccache_dir /var/lib/krb5_deleg_caches;
EOF
}

redirect_settings_locations()
{
	printf '%s\n' "${REDIRECT_SETTINGS}" | while read -r GROUP NAME DIRECTIVE VALUE; do
		if [ "${GROUP}" = "$1" ]; then
			cat <<EOF
		location /${GROUP}/settings/${NAME}/ {
			index /${GROUP}/settings/${NAME}/final;
			location = /${GROUP}/settings/${NAME}/final {
				${DIRECTIVE} ${VALUE};
				alias /var/www/kerberos/satisfyany;
			}
		}
EOF
		fi
	done
}

if [ "$HAS_CONSTRAINED_DELEGATION" = "yes" ]; then
    DELEGATION_DIRECTIVE="auth_gss_delegation both;"
else
    DELEGATION_DIRECTIVE="auth_gss_delegation unconstrained;"
fi


printf "Enabling pecl-authentication-krb5 ... "
PHP_VER=$(php -r "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;")
echo "extension=krb5.so" > "/etc/php/${PHP_VER}/fpm/conf.d/30-krb5.ini"
echo "OK"


# Session cookies need AES-256-GCM-SIV (OpenSSL 3.2 or later). Without it the
# module must refuse to start when a session key is configured. Probe what this
# nginx, module and OpenSSL actually do rather than guessing from versions.
printf "Checking whether nginx supports session cookies ... "
SESSION_PROBE_CONF="$(mktemp)"
cat <<EOF > "${SESSION_PROBE_CONF}" || die
include /etc/nginx/modules-enabled/*.conf;
error_log stderr;
pid ${SESSION_PROBE_CONF}.pid;
events {}
http {
	server {
		listen 127.0.0.1:8099;
		location / {
			auth_gss on;
			auth_gss_realm ${KERBEROS_REALM};
			auth_gss_keytab /etc/krb5.http.keytab;
			auth_gss_service_name HTTP/${TEST_HOST_FQDN};
			auth_gss_session_key "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20";
		}
	}
}
EOF
if SESSION_PROBE="$(nginx -t -c "${SESSION_PROBE_CONF}" 2>&1)"; then
	SESSION_COOKIES=yes
	echo "OK (supported)"
elif printf '%s\n' "${SESSION_PROBE}" \
	| grep -qF "session cookies require the AES-256-GCM-SIV cipher"; then
	SESSION_COOKIES=no
	echo "OK (unsupported, nginx refuses to start with a session key)"
else
	printf '%s\n' "${SESSION_PROBE}"
	rm -f "${SESSION_PROBE_CONF}"
	die
fi
rm -f "${SESSION_PROBE_CONF}"

printf "Creating nginx test site ... "
if ! cat <<EOF > /etc/nginx/sites-available/kerberos
# SPNEGO/Kerberos server test configuration
#
# A map supplies a variable so set assignments exercise variable values too.
map \$uri \$destination_ccache {
	default "FILE:/tmp/destination-cache";
}
# lua-resty-ldap and its dependencies are installed via luarocks to /usr/local
lua_package_path "/usr/local/share/lua/5.1/?.lua;/usr/local/share/lua/5.1/?/init.lua;;";
lua_package_cpath "/usr/local/lib/lua/5.1/?.so;;";

server {
	listen 8080;
	listen [::]:8080;

	root /var/www/kerberos;

	index index.php;

	server_name ${TEST_HOST_FQDN};

	location /noauth.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
		auth_gss off;
	}

	location /auth.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback off;
                auth_gss_authorized_principal alice@${KERBEROS_REALM};
                auth_gss_format_full on;
                fastcgi_param HTTP_AUTHORIZATION "";
                fastcgi_param KRB5CCNAME \$krb5_cc_name;
	}

	location /fallback.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback on;
                auth_gss_authorized_principal bob@${KERBEROS_REALM};
                auth_gss_format_full on;
                fastcgi_param HTTP_AUTHORIZATION "";
                fastcgi_param KRB5CCNAME \$krb5_cc_name;
	}

	# Basic-auth + auth_gss_map_to_local: $remote_user must come from the
	# GSS-verified principal mapped via gss_localname() (krb5.conf maps
	# bob -> bobmapped here), not the client-typed Basic auth username.
	location /maptolocal.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback on;
                auth_gss_map_to_local on;
                auth_gss_authorized_principal bobmapped;
                fastcgi_param HTTP_AUTHORIZATION "";
	}

	location /delegate.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback off;
                auth_gss_authorized_principal alice@${KERBEROS_REALM};
                auth_gss_format_full on;
                fastcgi_param HTTP_AUTHORIZATION "";
                fastcgi_param KRB5CCNAME \$krb5_cc_name;
                ${DELEGATION_DIRECTIVE}
                auth_gss_deleg_ccache_dir /var/lib/krb5_deleg_caches;
	}

	# Tests in-memory credential export: KRB5_EXPORTED_CRED carries the
	# gss_export_cred blob; KRB5CCNAME is intentionally not forwarded so
	# that export_check.php must derive the ccache entirely from the blob.
	# No constrained delegation is configured here; the client forwards
	# credentials directly because +ok_as_delegate is set on the HTTP
	# principal and curl uses its default delegation policy.
	location /export_check.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback off;
                auth_gss_authorized_principal alice@${KERBEROS_REALM};
                auth_gss_format_full on;
                fastcgi_param HTTP_AUTHORIZATION "";
                fastcgi_param KRB5CCNAME "";
                fastcgi_param KRB5_EXPORTED_CRED \$krb5_exported_cred;
                auth_gss_delegation unconstrained;
                auth_gss_deleg_ccache_dir /var/lib/krb5_deleg_caches;
	}

	# Channel binding directive on plain HTTP: no TLS session exists so the
	# module fails with a 500 error.
	location /cbinding_sep.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback off;
                auth_gss_authorized_principal alice@${KERBEROS_REALM};
                auth_gss_format_full on;
                fastcgi_param HTTP_AUTHORIZATION "";
                auth_gss_channel_binding server-end-point;
	}

	# satisfy any: verifies that the mutual-auth WWW-Authenticate: Negotiate
	# <token> survives nginx's satisfy-any header cleanup.
	location /satisfyany {
		satisfy any;
		auth_gss on;
		auth_gss_realm ${KERBEROS_REALM};
		auth_gss_keytab /etc/krb5.http.keytab;
		auth_gss_service_name HTTP/${TEST_HOST_FQDN};
		auth_gss_allow_basic_fallback off;
	}

	# Public destinations keep the delegated credentials after a redirect.
	location /delegate_public/ {
$(delegation_settings alice)
                index /public_delegate.php;
	}

	location /delegate_public_sub/ {
$(delegation_settings alice)
                index /public_sub_delegate.php;
	}

	# A public SSI subrequest keeps credentials after the parent refuses the login.
	location /delegate_sub_refused/ {
$(delegation_settings alice)
		index /delegate_sub_refused/denied.html;

		location /delegate_sub_refused/wrong/ {
			index /delegate_sub_refused/wrong.html;
		}

		location = /delegate_sub_refused/wrong.html {
			ssi on;
			alias /var/www/kerberos/deny_sub.html;
			satisfy any;
			allow all;
			auth_gss_allow_basic_fallback on;
			more_set_input_headers "Authorization: Basic Ym9iOndyb25n";
		}

		location = /delegate_sub_refused/denied.html {
			ssi on;
			alias /var/www/kerberos/deny_sub.html;
			satisfy any;
			allow all;
			auth_gss_allow_basic_fallback on;
			auth_gss_authorized_principal bob@${KERBEROS_REALM};
		}
	}

	location /delegate_clear_public/ {
$(delegation_settings alice)
		index /delegate_clear_public/check;

		location = /delegate_clear_public/check {
			more_clear_input_headers Authorization;
			error_page 401 = /public_clear_ccache;
		}
	}

	location = /public_clear_ccache {
		auth_gss off;
		proxy_set_header Authorization "";
		proxy_set_header X-Ccache \$krb5_cc_name;
		proxy_pass http://127.0.0.1:8082/ccache_check;
	}

	location /public_delegate.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss off;
                fastcgi_param KRB5CCNAME \$krb5_cc_name;
	}

	location /public_sub_delegate.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss off;
                auth_request /sub_delegate.php;
                fastcgi_param KRB5CCNAME \$krb5_cc_name;
	}

	location = /sub_delegate.php {
		internal;
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
                auth_gss off;
                fastcgi_param KRB5CCNAME \$krb5_cc_name;
	}

	# A protected rewrite cannot copy the cache, but the public backend can.
	location /delegate_hidden/ {
$(delegation_settings alice)
                index /read_hidden_ccache;
	}

	location = /read_hidden_ccache {
                auth_gss on;
                set \$copied_ccache \$krb5_cc_name;
                rewrite ^ /ccache_public last;
	}

	location = /ccache_public {
                auth_gss off;
                proxy_set_header Authorization "";
                proxy_set_header X-Ccache \$krb5_cc_name;
                proxy_set_header X-Copied-Ccache "before:\$copied_ccache";
                proxy_pass http://127.0.0.1:8082/ccache_check;
	}

	location /delegate_chain/ {
$(delegation_settings alice)
                index /delegate_chain_refused.php;
$(redirect_settings_locations delegate_chain)
		location /delegate_chain/header/ {
			index /header_bob_basic.php;
		}
	}

	location /delegate_chain_refused.php {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php-fpm.sock;
$(delegation_settings bob)
                error_page 403 = /delegate.php;
	}

