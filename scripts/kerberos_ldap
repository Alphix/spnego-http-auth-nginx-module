                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback off;
                auth_gss_format_full on;
                proxy_set_header Authorization "";
                proxy_set_header X-Ccache \$krb5_cc_name;
                proxy_set_header X-Copied-Ccache "before:\$ccache_copy";
                proxy_pass http://127.0.0.1:8082/ccache_check;
	}

	# auth_request_set, unlike set, leaves the earlier read's no_cacheable flag.
	location = /assigned_ccache_auth_request {
                set \$ccache_copy \$krb5_cc_name;
                auth_gss on;
                auth_gss_realm ${KERBEROS_REALM};
                auth_gss_keytab /etc/krb5.http.keytab;
                auth_gss_service_name HTTP/${TEST_HOST_FQDN};
                auth_gss_allow_basic_fallback off;
                auth_gss_format_full on;
                auth_request /assigned_ccache_auth_ok;
                auth_request_set \$krb5_cc_name \$destination_ccache;
                proxy_set_header Authorization "";
                proxy_set_header X-Ccache \$krb5_cc_name;
                proxy_pass http://127.0.0.1:8082/ccache_check;
	}

	location = /assigned_ccache_auth_ok {
                internal;
                auth_gss off;
                proxy_pass http://127.0.0.1:8082/ccache_check;
